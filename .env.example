# PostgreSQL
POSTGRES_DB=restromind
POSTGRES_USER=restromind_user
POSTGRES_PASSWORD=replace_with_a_secure_password
POSTGRES_PORT=5432

# Authentication
JWT_SECRET_KEY=replace_with_a_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
OWNER_SETUP_KEY=replace_with_a_separate_random_secret

# Frontend
FRONTEND_URL=http://localhost:5173

# Demo mode
DEMO_MODE=false

# Optional camera credential encryption
RTSP_ENCRYPTION_KEY=
